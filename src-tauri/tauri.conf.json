{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PT-NOTE",
  "version": "0.1.6",
  "identifier": "com.ptclinic.progressnote",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PT-NOTE",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://ptnote.vercel.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1QTUzNTM4RUE3ODIzN0UKUldSK0kzanFPRFdsWlZDV25PYVltQk1VTXhwZFJkV2JJWXJpeit6K3lhNU81VUJ4dVRJREZmcUcK",
      "endpoints": [
        "https://github.com/tone7718-droid/PT-Note-with-ChatGPT/releases/latest/download/latest.json"
      ]
    }
  }
}
